# ==============================================================
# Hümra Moda — Ortam Değişkenleri Şablonu (.env.example)
# GÜVENLİK NOTU: Bu dosyada gerçek parola veya gizli anahtar YER ALMAZ.
# Canlı veya yerel ortam için bu dosyayı kopyalayarak '.env.local' oluşturunuz.
# ==============================================================

# Uygulama Temel Ayarları
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Veri Erişim Sürücüsü (DAO Katmanı)
# Seçenekler: "json" (varsayılan aktif veri deposu) veya "postgres" (kontrollü geçiş)
DATA_STORE_DRIVER="json"

# Oturum ve Yetkilendirme
# Üretmek için terminalde: openssl rand -base64 32
AUTH_SECRET="ornek_32_karakterlik_gizli_anahtar_placeholder"
ADMIN_INITIAL_EMAIL="admin@humramoda.local"
ADMIN_INITIAL_PASSWORD="GuvenliGeciciParolaPlaceholder123!"

# Veritabanı (PostgreSQL)
# Format: postgresql://[KULLANICI]:[SIFRE]@[HOST]:[PORT]/[VERITABANI_ADI]?schema=public
# ------------------------------------------------------------------------------
# 1. Yerel Geliştirme (Local Development):
#    DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/humra_moda_local?schema=public"
#    DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/humra_moda_local?schema=public"
#
# 2. Test / CI Ortamı (İzole Test Veritabanı):
#    DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/humra_moda_test?schema=public"
#
# 3. Canlı / Üretim Ortamı (Managed PostgreSQL: Neon, Supabase, RDS, vb.):
#    DATABASE_URL="postgresql://user:password@pooler-host:6543/humramoda?schema=public&sslmode=require&pgbouncer=true"
#    DIRECT_URL="postgresql://user:password@direct-host:5432/humramoda?schema=public&sslmode=require"
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/humramoda?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/humramoda?schema=public"

# PayTR Ödeme Entegrasyonu
# GÜVENLİK KURALI: Bu anahtarlar ASLA NEXT_PUBLIC_ öneki almamalı ve istemciye gönderilmemelidir.
PAYTR_MERCHANT_ID="123456"
PAYTR_MERCHANT_KEY="ornek_paytr_magaza_parolasi"
PAYTR_MERCHANT_SALT="ornek_paytr_gizli_anahtar"
PAYTR_TEST_MODE="1" # Test ortamı için "1", canlı üretim için "0"
PAYTR_DEBUG_ON="1"  # Geliştirme/test için "1", canlıda "0"
APP_BASE_URL="http://localhost:3000" # Webhook ve dönüş URL'lerinin temel adresi

# Medya Depolama ve CDN (Faz 2'de yerel depolama kullanılır)
# Seçenekler: "local" (yerel /public/uploads) veya "r2" / "s3"
STORAGE_PROVIDER="local"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET_NAME=""
STORAGE_PUBLIC_URL=""

# Otomatik ve Şifreli Veritabanı Yedekleme (AES-256-GCM)
# Üretmek için terminalde: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY="ornek_64_karakterlik_onaltilik_sifreleme_anahtari_placeholder"

# E-posta ve Bildirim Servisleri (Opsiyonel / SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="bildirim@humramoda.com"
SMTP_PASS="ornek_smtp_parolasi"
EMAIL_FROM="Hümra Moda <bildirim@humramoda.com>"

